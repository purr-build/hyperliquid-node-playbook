{
  "uid": "node-overview",
  "title": "Node overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage",
      "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "Memory"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk usage",
      "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
          "expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}))",
          "legendFormat": "{{ '{{' }}mountpoint{{ '}}' }}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network throughput",
      "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval])",
          "legendFormat": "RX {{ '{{' }}device{{ '}}' }}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": {{ monitoring.grafana.datasource.uid | to_json }}},
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval])",
          "legendFormat": "TX {{ '{{' }}device{{ '}}' }}"
        }
      ]
    }
  ]
}
