[Unit]
Description=Sync Hyperliquid public data to edge mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart={{ edge_sync.script_path | default('/usr/local/bin/hl-edge-sync.py') }} --config {{ edge_sync.config_path | default('/etc/hl-edge-sync.yml') }}
TimeoutStartSec={{ edge_sync.timeout_start_sec | default('30min') }}
